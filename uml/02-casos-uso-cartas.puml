@startuml
title Casos de uso — Cartas e documentos

skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #555555
skinparam ActorBorderColor #51728A
skinparam UsecaseBackgroundColor #EAF3F8
skinparam UsecaseBorderColor #51728A
skinparam RectangleBackgroundColor #F8F9FA
skinparam RectangleBorderColor #777777
skinparam NoteBackgroundColor #EDF6EF
skinparam NoteBorderColor #63866D

left to right direction

actor Estudante as E
actor Supervisor as S
actor Empregabilidade as O

rectangle "Sistema de Gestão de Estágios Curriculares do ISDB" {

  usecase "Submeter pedido de carta" as U1
  usecase "Consultar pedidos e histórico" as U2
  usecase "Corrigir e voltar a submeter" as U3
  usecase "Receber aviso de carta pronta" as U4

  usecase "Tramitar pedidos de carta" as U5
  usecase "Filtrar e exportar pedidos" as U6
  usecase "Consultar relatórios" as U7
  usecase "Imprimir comprovativo\nnão oficial de disponibilidade" as U8

  usecase "Consultar e descarregar documentos" as U9
  usecase "Publicar e despublicar\ndocumentos gerais" as U10
}

E -- U1
E -- U2
E -- U3
E -- U4
E -- U8
E -- U9

S -- U9

O -- U5
O -- U2
O -- U6
O -- U7
O -- U9
O -- U10

note right of U5
  A assinatura e o carimbo
  são realizados fora do sistema.
end note

@enduml
